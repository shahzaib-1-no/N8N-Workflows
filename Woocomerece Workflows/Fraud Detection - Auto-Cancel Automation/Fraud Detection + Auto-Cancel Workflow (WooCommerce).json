        "color": 4
      },
      "id": "0ef394f7-e436-4a43-b840-d192265e811b",
      "name": "Note: Title",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        320,
        64
      ]
