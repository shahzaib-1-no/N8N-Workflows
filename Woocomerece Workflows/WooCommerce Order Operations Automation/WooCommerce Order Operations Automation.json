    {
      "parameters": {
        "jsCode": "// Get order date string (e.g. \"01/08/2026 20:42:42\")\nlet orderDateStr = $input.first().json.date_created;\n\n// Split Date and Time\nlet [datePart, timePart] = orderDateStr.split(' ');\nlet [day, month, year] = datePart.split('/');\nlet [hours, minutes, seconds] = timePart.split(':');\n\n// Format to ISO string with Pakistan Timezone (+05:00)\nlet isoStr = `${year}-${month.padStart(2, '0')}-${day.padStart(2, '0')}T${hours.padStart(2, '0')}:${minutes.padStart(2, '0')}:${seconds.padStart(2, '0')}+05:00`;\n\nlet orderTime = new Date(isoStr);\nlet currentTime = new Date(); // Current system time\n\n// Calculate difference in minutes\nlet diffInMilliseconds = currentTime - orderTime;\nlet diffInMinutes = Math.floor(diffInMilliseconds / (1000 * 60));\n\nif (diffInMinutes < 0) {\n    diffInMinutes = 0;\n}\n\nreturn [{\n    json: {\n        order_id: $input.first().json.order_id,\n        customer_name: $input.first().json.customer_name,\n      total: $input.first().json.total,\n      currency: $input.first().json.currency,\n        minutesAgo: diffInMinutes\n    }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        528,
        656
      ],
      "id": "25f24cc4-1b02-4837-824e-20f368cd6bc7",
      "name": "time-calculate"
    },
