    {
      "parameters": {
        "jsCode": "// Loop through all incoming items (webhook data)\nfor (const item of $input.all()) {\n  \n  let cartData = item.json;\n  let cartTotalAmount = 0;\n\n  // Check if the 'body.items' array exists\n  if (cartData.body && cartData.body.items && Array.isArray(cartData.body.items)) {\n    \n    // Loop through each product (item) to perform calculations\n    cartData.body.items.forEach(product => {\n      \n      // Convert strings to numbers and multiply (Price x Quantity)\n      let price = parseFloat(product.price || 0);\n      let quantity = parseInt(product.quantity || 1);\n      let lineTotal = price * quantity;\n      \n      // Save the calculated total inside each item\n      product.calculated_item_total = lineTotal;\n      \n      // Add this item's total to the overall cart total amount\n      cartTotalAmount += lineTotal;\n    });\n  }\n\n  // Add a new field 'calculated_cart_total' to the existing data\n  cartData.calculated_cart_total = cartTotalAmount;\n  \n  // Reassign the updated data back to item.json\n  item.json = cartData;\n}\n\n// Return the processed data\nreturn $input.all();"
      },
