    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const item = $input.first().json;\nconst errors = [];\nconst email = String(item.email || '').trim().toLowerCase();\nconst phone = String(item.phone || '').replace(/\\D/g, '');\n\nif (!email || !email.includes('@') || email.length < 5) {\n  errors.push('email');\n}\nif (!item.fullName && !item.firstName && !item.company) {\n  errors.push('name_or_company');\n}\n\n// Fingerprint = SHA256 of normalized (email + phone) — used for dedup\nconst crypto = require('crypto');\nconst fingerprintInput = email + '|' + phone;\nconst fingerprint = crypto.createHash('sha256').update(fingerprintInput).digest('hex').slice(0, 24);\n\nreturn {\n  json: {\n    ...item,\n    email: email,\n    phone: phone,\n    isValid: errors.length === 0,\n    validationErrors: errors.join(',') || null,\n    fingerprint: fingerprint,\n    fingerprintInput: fingerprintInput\n  }\n};"
      },
