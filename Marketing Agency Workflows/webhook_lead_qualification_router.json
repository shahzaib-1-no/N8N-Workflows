    {
      "parameters": {
        "promptType": "define",
        "text": "=Analyze this inbound lead and return strict JSON matching the schema. Use BANT + ICP heuristics.\n\n---\nEmail: {{ $json.email }}\nFull name: {{ $json.fullName }}\nJob title: {{ $json.jobTitle }}\nCompany: {{ $json.company }}\nIndustry: {{ $json.industry }}\nCompany size: {{ $json.companySize }}\nLocation: {{ $json.location }}\nLinkedIn: {{ $json.linkedin }}\nSource: {{ $json.source }}\nCampaign: {{ $json.campaign }}\nAd set: {{ $json.adSet }}\nKeyword: {{ $json.keyword }}\nMessage from lead:\n\"\"\"\n{{ $json.message }}\n\"\"\"\n\n---\nScoring guide:\n- Hot (75+): clear ICP fit, explicit budget or authority, urgency in days\n- Warm (50-74): decent fit or timing unclear, missing 1-2 signals\n- Cold (<50): poor fit or just exploring\n\nFlag is_spam = true if spam_likelihood > 0.6 (gibberish, bot patterns, fake emails, irrelevant/competitor inquiry).",
        "hasOutputParser": true,
        "messages": {
          "messageValues": [
            {
              "type": "SystemMessage",
              "message": "You are an expert B2B lead qualification analyst. Always respond with strict JSON matching the provided schema. No prose, no markdown. Score objectively using BANT (Budget, Authority, Need, Timeline) and ICP fit. Be honest about low-quality leads — never inflate scores. Keep summaries short, specific, and actionable."
            }
          ]
        }
      },
      "id": "48c0aa70-d3c5-4340-ae36-96fa0c6a43a0",
      "name": "AI Lead Qualification Agent",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.5,
      "position": [
        4000,
        1328
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const item = $input.first().json;\nlet ai = {};\ntry {\n  // Basic LLM Chain with structured output returns a stringified JSON in 'output'\n  ai = typeof item.output === 'string' ? JSON.parse(item.output) : (item.output || item);\n} catch (e) {\n  return { json: { error: 'parse_failed', raw: item.output || item, executionId: item.executionId } };\n}\n\nconst lead = $('Merge Enrichment + Lead').first().json;\nconst tier = ai.tier || (ai.quality_score >= 75 ? 'Hot' : ai.quality_score >= 50 ? 'Warm' : 'Cold');\nconst isSpam = ai.is_spam === true || (typeof ai.spam_likelihood === 'number' && ai.spam_likelihood > 0.6);\n\nreturn {\n  json: {\n    ...lead,\n    quality_score: ai.quality_score || 0,\n    tier,\n    intent: ai.intent || '',\n    urgency: ai.urgency || 'no_timeline',\n    budget_signal: ai.budget_signal || 'no_budget_signal',\n    spam_likelihood: ai.spam_likelihood || 0,\n    is_spam: isSpam,\n    rejection_reason: ai.rejection_reason || '',\n    industry: ai.industry || lead.industry || '',\n    recommended_assignee: ai.recommended_assignee || 'default_rep',\n    follow_up_priority: ai.follow_up_priority || 'P2_this_week',\n    summary: ai.summary || '',\n    talking_points: Array.isArray(ai.talking_points) ? ai.talking_points : [],\n    ai_parsed: true\n  }\n};"
      },
