      "id": "07cd899d-5794-42e5-af09-eb8df2fbaf4d",
      "name": "OpenAI Chat Model (gpt-4o-mini)",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1,
