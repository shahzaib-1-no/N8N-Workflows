        "jsCode": "const items = $input.all();\nconst outputItems = [];\nconst now = new Date();\n\nfor (const item of items) {\n  const startDate = new Date(item.json.start_date);\n  \n  // Hours ka farq calculate karna aur whole number banana\n  const diffMs = now - startDate;\n  const diffHours = diffMs / (1000 * 60 * 60);\n\n  outputItems.push({\n    json: {\n      ...item.json,\n      hoursPassed: Math.floor(diffHours)\n    }\n  });\n}\n\nreturn outputItems;"
      },
