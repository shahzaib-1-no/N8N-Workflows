    {
      "parameters": {
        "jsCode": "const budgetScores = {\n  \"Under $500\": 0,\n  \"$500–$1,000\": 10,\n  \"$1,000–$2,500\": 20,\n  \"$2,500–$5,000\": 30,\n  \"$5,000–$10,000\": 40,\n  \"$10,000+\": 50,\n};\n\nconst companyScores = {\n  \"Solo / 1 person\": 5,\n  \"2–10 employees\": 10,\n  \"11–50 employees\": 15,\n  \"51–200 employees\": 20,\n  \"201–500 employees\": 25,\n  \"500+ employees\": 30,\n};\n\nconst serviceScores = {\n  \"CRM Automation\": 20,\n  \"Sales Automation\": 20,\n  \"Marketing Automation\": 15,\n  \"Lead Generation Automation\": 15,\n  \"Data Integration\": 10,\n  \"Custom Automation\": 10,\n  \"Not Sure\": 5,\n};\n\nconst budgetScore = budgetScores[$input.first().json.budget_range] ?? 0;\nconst companyScore = companyScores[$input.first().json.company_size] ?? 0;\nconst serviceScore = serviceScores[$input.first().json.service_needed] ?? 0;\n\nreturn [\n  {\n    object_id: $input.first().json.object_id,\n    firstname: $input.first().json.firstname,\n    lastname: $input.first().json.lastname,\n    email: $input.first().json.email,\n    phone: $input.first().json.phone,\n    company: $input.first().json.company,\n    company_size: $input.first().json.company_size,\n    budget_range: $input.first().json.budget_range,\n    service_needed: $input.first().json.service_needed,\n    hs_lead_status: $input.first().json.hs_lead_status,\n    budget_score: budgetScore,\n    company_score: companyScore,\n    service_score: serviceScore,\n    lead_score: budgetScore + companyScore + serviceScore,\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
